---
import { getCollection, render } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import Notices from '../../components/Notices.astro';
import ReadingNav from '../../components/ReadingNav.astro';
import SourceList from '../../components/SourceList.astro';
import Timeline from '../../components/Timeline.astro';
import Base from '../../layouts/Base.astro';
import {
  articlesInTopic,
  formatDate,
  formatPartialDate,
  getArticles,
  statusLabel,
  type Topic,
} from '../../lib/site';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { id: topic.id }, props: { topic } }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const { data } = topic;
const { Content } = await render(topic);
const articles = articlesInTopic(await getArticles(), topic.id);
const navigation = [
  ...(articles.length > 0 ? [{ href: '#topic-articles-heading', label: '記事' }] : []),
  { href: '#topic-background', label: '経緯と背景' },
  ...(data.people.length > 0 ? [{ href: '#people-heading', label: '主な関係者' }] : []),
  ...(data.timeline.length > 0 ? [{ href: '#timeline-heading', label: '年表' }] : []),
  ...(data.watch.length > 0 ? [{ href: '#watch-heading', label: '今後の注目点' }] : []),
  ...(data.sources.length + data.reporting.length > 0
    ? [{ href: '#sources-heading', label: '出典・取材' }]
    : []),
];
---

<Base title={data.title} description={data.summary}>
  <article class="topic reading-page">
    <header class="article-header reading-header">
      <p class="kicker">
        <span class={`status status-${data.status}`}>{statusLabel[data.status]}</span>
        <span>トピック</span>
        <span>{formatDate(data.updated)} 更新</span>
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
    </header>

    <div class="reading-layout">
      <ReadingNav title="このトピックの内容" items={navigation} />
      <div class="reading-main">
        <Notices kinds={data.notices} />

        {
          articles.length > 0 && (
            <section aria-labelledby="topic-articles-heading">
              <h2 id="topic-articles-heading" class="section-heading">記事</h2>
              <ArticleList articles={articles} showTopics={false} compact />
            </section>
          )
        }

        <section id="topic-background" class="prose" aria-label="経緯と背景">
          <Content />
        </section>

        {
          data.people.length > 0 && (
            <section aria-labelledby="people-heading">
              <h2 id="people-heading" class="section-heading">主な関係者</h2>
              <dl class="people">
                {data.people.map((p) => (
                  <>
                    <dt>{p.name}</dt>
                    <dd>{p.role}</dd>
                  </>
                ))}
              </dl>
            </section>
          )
        }

        {
          data.timeline.length > 0 && (
            <section aria-labelledby="timeline-heading">
              <h2 id="timeline-heading" class="section-heading">年表</h2>
              <Timeline items={data.timeline} sources={data.sources} reporting={data.reporting} />
            </section>
          )
        }

        {
          data.watch.length > 0 && (
            <section aria-labelledby="watch-heading">
              <h2 id="watch-heading" class="section-heading">今後の注目点</h2>
              <ul class="watch">
                {data.watch.map((w) => (
                  <li>
                    {w.date && <time datetime={w.date}>{formatPartialDate(w.date)}</time>}
                    {w.text}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <SourceList sources={data.sources} reporting={data.reporting} />
      </div>
    </div>
  </article>
</Base>
